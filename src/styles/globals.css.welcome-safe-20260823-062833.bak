@import './theme.css';

@font-face{font-family:EVSans;src:url('/fonts/dm-sans-400.ttf') format('truetype');font-weight:400;font-display:swap}
@font-face{font-family:EVSans;src:url('/fonts/dm-sans-600.ttf') format('truetype');font-weight:600;font-display:swap}
@font-face{font-family:EVDisplay;src:url('/fonts/manrope-800.ttf') format('truetype');font-weight:800;font-display:swap}
*{box-sizing:border-box}html{background:var(--bg);scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);font-family:EVSans,Inter,system-ui,sans-serif;-webkit-font-smoothing:antialiased}button,input,select{font:inherit}button,a{touch-action:manipulation}button{color:inherit}a{color:inherit;text-decoration:none}img{display:block;max-width:100%}::selection{background:var(--accent);color:var(--accent-ink)}:focus-visible{outline:2px solid var(--accent);outline-offset:3px}.icon{flex:none}.eyebrow{display:block;color:var(--accent);font-size:11px;font-weight:700;letter-spacing:.18em;text-transform:uppercase}.app-shell{min-height:100vh}.app-content{min-height:calc(100vh - var(--header-h));padding-top:var(--header-h)}.page{padding:54px var(--page) 90px;max-width:1680px;margin:auto}.page-stack{display:grid;gap:54px;padding:50px var(--page) 100px;max-width:1680px;margin:auto}
.brand{display:flex;align-items:center;gap:1px;font:800 24px/1 EVDisplay,system-ui;letter-spacing:-.08em}.brand i{color:var(--accent);font-style:normal}.brand small{margin-left:9px;color:var(--text-3);font:600 8px/1 EVSans;letter-spacing:.24em}.site-header{position:fixed;inset:0 0 auto;z-index:40;height:var(--header-h);display:flex;align-items:center;padding:0 var(--page);gap:clamp(28px,4vw,64px);background:color-mix(in srgb,var(--bg) 82%,transparent);border-bottom:1px solid var(--line);backdrop-filter:blur(20px)}.desktop-nav{display:flex;align-self:stretch}.desktop-nav a{position:relative;display:flex;align-items:center;padding:0 15px;color:var(--text-2);font-size:14px;font-weight:600}.desktop-nav a:after{position:absolute;content:'';height:2px;inset:auto 15px -1px;background:var(--accent);transform:scaleX(0);transition:.25s}.desktop-nav a:hover,.desktop-nav a.active{color:var(--text)}.desktop-nav a.active:after{transform:scaleX(1)}.header-actions{margin-left:auto;display:flex;align-items:center;gap:9px}.icon-button{width:42px;height:42px;display:grid;place-items:center;border:1px solid var(--line);border-radius:50%;background:var(--surface-glass);cursor:pointer}.icon-button:hover{border-color:var(--line-strong);background:var(--surface-2)}.profile-menu{position:relative}.profile-trigger{height:44px;display:flex;align-items:center;gap:9px;padding:4px 10px 4px 4px;background:var(--surface);border:1px solid var(--line);border-radius:24px;cursor:pointer}.profile-trigger>span,.mini-avatar{display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,#48556e,#202631);font-weight:700}.profile-trigger b{font-size:13px}.profile-trigger .icon{transform:rotate(90deg)}.profile-popover{position:absolute;right:0;top:52px;width:250px;padding:10px;background:var(--surface);border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow)}.profile-popover>div{display:flex;align-items:center;gap:11px;padding:8px 9px 14px;border-bottom:1px solid var(--line);margin-bottom:5px}.profile-popover p{display:grid;margin:0}.profile-popover small{color:var(--text-3)}.profile-popover button,.profile-popover>a{width:100%;display:flex;align-items:center;gap:10px;padding:11px 9px;border:0;background:none;border-radius:9px;text-align:left;cursor:pointer;font-size:13px}.profile-popover button:hover,.profile-popover>a:hover{background:var(--surface-2)}kbd{min-width:24px;padding:3px 6px;border:1px solid var(--line-strong);border-radius:5px;background:var(--bg-soft);font:600 11px EVSans;text-align:center}.mobile-nav{display:none}.offline-banner{position:fixed;z-index:80;left:50%;top:12px;transform:translateX(-50%);display:flex;align-items:center;gap:9px;padding:10px 16px;background:var(--warning);color:#161005;border-radius:30px;font-size:12px;font-weight:700;box-shadow:var(--shadow)}
.profile-screen{position:relative;min-height:100vh;overflow:hidden;display:grid;grid-template-rows:auto 1fr auto;padding:34px clamp(22px,5vw,78px);background:radial-gradient(circle at 50% 35%,#1c2229 0,#090b0e 45%,#050607 75%)}.profile-ambient{position:absolute;width:500px;height:500px;border-radius:50%;filter:blur(120px);opacity:.15}.profile-ambient--one{background:var(--accent);left:-300px;top:-200px}.profile-ambient--two{background:#637bff;right:-300px;bottom:-200px}.profile-top,.profile-footer{position:relative;z-index:1;display:flex;justify-content:space-between;align-items:center}.profile-top>span{color:var(--text-3);font-size:12px;letter-spacing:.08em}.profile-panel{position:relative;z-index:1;align-self:center;text-align:center}.profile-panel h1{margin:11px 0 8px;font:800 clamp(38px,6vw,72px)/1 EVDisplay;letter-spacing:-.055em}.profile-panel>p{margin:0;color:var(--text-2)}.profile-grid{display:flex;justify-content:center;flex-wrap:wrap;gap:clamp(14px,2vw,26px);margin-top:46px}.profile-card{width:160px;padding:0;border:0;background:none;cursor:pointer}.profile-avatar{position:relative;display:grid;place-items:center;aspect-ratio:1;border:1px solid var(--line-strong);border-radius:28px;background:linear-gradient(145deg,#2b3541,#11161c);font:800 46px EVDisplay;box-shadow:0 18px 40px rgba(0,0,0,.28);transition:transform .3s var(--ease),border-color .3s}.profile-avatar:after{position:absolute;content:'';inset:8px;border:1px solid rgba(255,255,255,.06);border-radius:21px}.profile-avatar--1{background:linear-gradient(145deg,#40373c,#171316)}.profile-avatar--2{background:linear-gradient(145deg,#263b37,#111a18)}.profile-avatar--3{background:linear-gradient(145deg,#3b354c,#15121c)}.profile-card:hover .profile-avatar{transform:translateY(-7px);border-color:var(--accent)}.profile-card strong{display:block;margin-top:16px;font-size:15px}.profile-card small{display:block;margin-top:4px;color:var(--text-3);font-size:11px}.profile-card--add .profile-avatar{border-style:dashed;color:var(--text-2);background:rgba(255,255,255,.025)}.profile-footer{color:var(--text-3);font-size:9px;font-weight:700;letter-spacing:.22em}
.hero{position:relative;min-height:min(76vh,780px);display:flex;align-items:flex-end;padding:clamp(120px,18vh,200px) var(--page) clamp(70px,9vh,110px);background-image:var(--hero-image);background-size:cover;background-position:center 22%}.hero:after{position:absolute;content:'';inset:0;background:linear-gradient(90deg,rgba(5,6,8,.95) 0,rgba(5,6,8,.66) 43%,rgba(5,6,8,.12) 72%),linear-gradient(0deg,var(--bg) 0,transparent 38%)}:root[data-theme='light'] .hero:after,:root[data-theme='light'] .title-hero__fade{background:linear-gradient(90deg,rgba(244,243,239,.95),rgba(244,243,239,.55) 46%,rgba(244,243,239,.05) 75%),linear-gradient(0deg,var(--bg),transparent 40%)}.hero__content{position:relative;z-index:2;max-width:650px}.hero h1{margin:13px 0 16px;font:800 clamp(54px,8vw,108px)/.9 EVDisplay;letter-spacing:-.065em}.hero__meta,.title-meta{display:flex;align-items:center;gap:14px;color:var(--text-2);font-size:13px}.hero__meta span+span:before,.title-meta span+span:before{content:'•';margin-right:14px;color:var(--text-3)}.hero__content>p{max-width:560px;margin:18px 0 27px;color:var(--text-2);font-size:clamp(15px,1.3vw,18px);line-height:1.65;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.hero__actions,.title-actions{display:flex;gap:10px;flex-wrap:wrap}.button{min-height:44px;display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:0 18px;border:1px solid transparent;border-radius:11px;font-weight:700;font-size:13px;cursor:pointer;transition:.2s}.button--primary{background:var(--accent);color:var(--accent-ink)}.button--primary:hover{filter:brightness(1.07);transform:translateY(-2px)}.button--glass,.button--subtle{background:var(--surface-glass);border-color:var(--line);backdrop-filter:blur(14px)}.button--glass:hover,.button--subtle:hover{border-color:var(--line-strong);background:var(--surface-2)}.button:disabled{opacity:.45;cursor:not-allowed}.hero__index{position:absolute;right:var(--page);bottom:90px;z-index:2;display:grid;justify-items:end}.hero__index i{font:800 64px EVDisplay;color:transparent;-webkit-text-stroke:1px rgba(255,255,255,.3)}.hero__index span{color:var(--text-3);font-size:10px;text-transform:uppercase;letter-spacing:.18em}.hero--skeleton{background:var(--surface)}.hero--skeleton .skeleton{position:absolute;inset:0}
.section-title{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:18px}.section-title h2{margin:0;font:800 clamp(21px,2.2vw,30px) EVDisplay;letter-spacing:-.035em}.section-title>span,.section-title>button{color:var(--text-3);font-size:11px}.section-title>button{border:0;background:none;cursor:pointer}.media-rail,.continue-rail{display:grid;grid-auto-flow:column;grid-auto-columns:clamp(145px,14vw,210px);gap:15px;overflow-x:auto;padding:2px 2px 15px;scrollbar-width:thin;scrollbar-color:var(--line-strong) transparent;scroll-snap-type:x proximity}.continue-rail{grid-auto-columns:clamp(260px,27vw,390px)}.media-card{min-width:0;scroll-snap-align:start}.media-card__art{position:relative;aspect-ratio:2/3;overflow:hidden;border-radius:var(--radius);background:var(--surface);border:1px solid var(--line);transition:.3s var(--ease)}.media-card__art img,.continue-card__art img,.title-poster img,.episode-card__art img{width:100%;height:100%;object-fit:cover}.media-card:hover .media-card__art{transform:translateY(-6px);border-color:var(--line-strong);box-shadow:0 18px 35px rgba(0,0,0,.25)}.media-card__play,.continue-card__play,.episode-card__play{position:absolute;display:grid;place-items:center;width:42px;height:42px;right:10px;bottom:10px;border-radius:50%;background:var(--accent);color:var(--accent-ink);opacity:0;transform:scale(.8);transition:.25s}.media-card:hover .media-card__play,.continue-card:hover .continue-card__play,.episode-card:hover .episode-card__play{opacity:1;transform:scale(1)}.media-card__copy{display:grid;gap:5px;padding:12px 3px}.media-card__copy strong{font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.media-card__copy span{color:var(--text-3);font-size:11px;text-transform:capitalize}.media-card__rank{position:absolute;left:8px;bottom:-12px;color:#fff;font:800 68px/.9 EVDisplay;-webkit-text-stroke:1px rgba(0,0,0,.35);text-shadow:0 4px 18px #000}.image-fallback{width:100%;height:100%;display:grid;place-items:center;background:linear-gradient(145deg,var(--surface-2),var(--bg-soft));color:var(--text-3);font:800 18px EVDisplay}.continue-card{min-width:0}.continue-card__art{position:relative;aspect-ratio:16/9;overflow:hidden;border:1px solid var(--line);border-radius:var(--radius);background:var(--surface)}.continue-card>div+div{display:grid;gap:5px;padding:11px 2px}.continue-card strong{font-size:14px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.continue-card span{color:var(--text-3);font-size:11px}.progress{position:absolute!important;inset:auto 0 0;height:3px;background:rgba(255,255,255,.18)}.progress i{display:block;height:100%;background:var(--accent)}
.page-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:36px}.page-heading h1{margin:10px 0 7px;font:800 clamp(38px,6vw,70px)/.95 EVDisplay;letter-spacing:-.055em}.page-heading p{margin:0;color:var(--text-2);font-size:14px}.catalog-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:28px 16px}.filter-tabs{display:flex;gap:5px;margin:-16px 0 30px;padding:4px;width:max-content;background:var(--surface);border:1px solid var(--line);border-radius:12px}.filter-tabs button{padding:9px 18px;border:0;border-radius:8px;background:none;color:var(--text-2);font-size:12px;font-weight:700;cursor:pointer}.filter-tabs button.active{background:var(--accent);color:var(--accent-ink)}.saved-card{position:relative}.remove-button{position:absolute;right:9px;top:9px;width:34px;height:34px;display:grid;place-items:center;border:1px solid var(--line-strong);border-radius:50%;background:rgba(7,8,9,.75);color:#fff;cursor:pointer;opacity:0;transition:.2s}.saved-card:hover .remove-button{opacity:1}
.state-card{display:flex;align-items:center;gap:18px;padding:24px;border:1px solid var(--line);border-radius:var(--radius);background:var(--surface)}.state-card--error{border-color:color-mix(in srgb,var(--danger) 30%,var(--line))}.state-card--empty{min-height:220px;justify-content:center;text-align:center;flex-direction:column}.state-card--compact{min-height:130px}.state-card h3{margin:0 0 5px}.state-card p{margin:0;color:var(--text-2);font-size:13px;line-height:1.5}.state-icon{width:44px;height:44px;display:grid;place-items:center;border-radius:50%;background:var(--surface-2);color:var(--text-2)}.skeleton{display:block;aspect-ratio:2/3;border-radius:var(--radius);background:linear-gradient(100deg,var(--surface) 20%,var(--surface-2) 38%,var(--surface) 56%);background-size:220% 100%;animation:shine 1.5s infinite}.skeleton--hero{aspect-ratio:auto}.skeleton--channel{aspect-ratio:4/1}.skeleton-rail{display:grid;grid-template-columns:repeat(6,1fr);gap:15px}@keyframes shine{to{background-position-x:-220%}}
.search-page{max-width:1440px}.search-box{height:66px;display:flex;align-items:center;gap:15px;padding:0 19px;margin-bottom:20px;border:1px solid var(--line);border-radius:17px;background:var(--surface)}.search-box:focus-within{border-color:var(--accent)}.search-box input{flex:1;min-width:0;border:0;outline:0;background:none;color:var(--text);font-size:18px}.search-box>button{border:0;background:none;cursor:pointer}.search-box--small{height:45px;margin:0;max-width:380px;border-radius:11px}.search-box--small input{font-size:13px}.recent-searches{margin:35px 0}.recent-searches>div:last-child{display:flex;gap:8px;flex-wrap:wrap}.recent-searches>div button{display:flex;align-items:center;gap:7px;padding:10px 13px;border:1px solid var(--line);border-radius:20px;background:var(--surface);cursor:pointer;color:var(--text-2)}
.title-loading{height:90vh;padding:var(--page)}.title-loading .skeleton{height:100%}.title-hero{position:relative;min-height:calc(100vh - var(--header-h));display:flex;align-items:flex-end;padding:140px var(--page) 80px;background-image:var(--hero-image);background-size:cover;background-position:center}.title-hero__fade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(7,8,9,.96),rgba(7,8,9,.72) 53%,rgba(7,8,9,.2)),linear-gradient(0deg,var(--bg),transparent 48%)}.title-layout{position:relative;z-index:1;display:grid;grid-template-columns:minmax(190px,260px) minmax(0,720px);gap:clamp(28px,5vw,74px);align-items:end}.title-poster{aspect-ratio:2/3;border-radius:var(--radius-lg);overflow:hidden;border:1px solid var(--line-strong);box-shadow:var(--shadow)}.title-copy h1{margin:11px 0 16px;font:800 clamp(48px,7vw,96px)/.92 EVDisplay;letter-spacing:-.06em}.rating{color:var(--accent)}.genre-list{display:flex;flex-wrap:wrap;gap:7px;margin:18px 0}.genre-list span{padding:7px 10px;border:1px solid var(--line);border-radius:20px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.08em}.title-description{max-width:700px;color:var(--text-2);font-size:15px;line-height:1.75}.title-actions{margin:25px 0}.inline-error{display:block;color:var(--danger);margin:10px 0}.credits{display:grid;grid-template-columns:70px 1fr;gap:8px;margin:24px 0 0;font-size:12px}.credits dt{color:var(--text-3)}.credits dd{margin:0;color:var(--text-2)}.title-episodes{padding-top:40px}.season-browser>header{display:flex;justify-content:space-between;align-items:end;margin-bottom:25px}.season-browser h2{margin:8px 0 0;font:800 32px EVDisplay}.select-wrap{display:flex;align-items:center;gap:10px;color:var(--text-3);font-size:11px}.select-wrap select{min-width:150px;padding:11px 36px 11px 13px;border:1px solid var(--line);border-radius:10px;background:var(--surface);color:var(--text)}.episode-list{display:grid;gap:10px}.episode-card{display:grid;grid-template-columns:230px 1fr;gap:20px;padding:10px;border:1px solid var(--line);border-radius:var(--radius);background:var(--surface);transition:.2s}.episode-card:hover{border-color:var(--line-strong);transform:translateX(4px)}.episode-card__art{position:relative;aspect-ratio:16/9;overflow:hidden;border-radius:10px;background:var(--surface-2)}.episode-card__copy{display:grid;grid-template-columns:38px 1fr auto;align-items:center;gap:13px}.episode-number{color:var(--text-3);font:800 22px EVDisplay}.episode-card h3,.episode-card strong{font-size:14px}.episode-card p{margin:7px 0 0;color:var(--text-2);font-size:12px;line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.episode-state{color:var(--text-3);font-size:9px;text-transform:uppercase;letter-spacing:.12em}.episode-card--current{border-color:color-mix(in srgb,var(--accent) 45%,var(--line))}.episode-card--watched{opacity:.68}
.watch-page,.iptv-watch{min-height:100vh;padding:18px clamp(16px,3vw,45px) 50px;background:#050607}.watch-page .player-header,.iptv-watch>header{height:58px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:20px;color:#f5f7f8}.player-back,.iptv-watch>header>a{display:flex;align-items:center;gap:8px;font-size:12px;color:#b1b5bb}.player-header>div{text-align:center;display:grid}.player-header>div span{color:#747b84;font-size:10px}.sync-button{justify-self:end;padding:8px 12px;border:1px solid rgba(255,255,255,.12);border-radius:9px;background:#12151a;color:#ddd;font-size:11px;cursor:pointer}.sync-button--synced{color:var(--success)}.sync-button--error{color:var(--danger)}.player-stage,.live-stage{position:relative;aspect-ratio:16/9;max-height:calc(100vh - 125px);margin:auto;overflow:hidden;border:1px solid rgba(255,255,255,.1);border-radius:18px;background:#000;box-shadow:0 30px 90px #000}.player-stage iframe,.live-stage video{position:absolute;inset:0;width:100%;height:100%;border:0}.player-loader{position:absolute;inset:0;display:grid;place-content:center;justify-items:center;color:#8a9098;font-size:12px}.player-loader span{width:34px;height:34px;border:2px solid #242831;border-top-color:var(--accent);border-radius:50%;animation:spin .8s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}.player-footer,.iptv-watch>footer{display:grid;grid-template-columns:1fr auto;gap:25px;max-width:1200px;margin:35px auto 0}.player-footer h1,.iptv-watch h1{margin:7px 0;font:800 30px EVDisplay}.player-footer p,.iptv-watch footer p{margin:0;color:#858b94;font-size:12px}.episode-nav{display:flex;align-items:center;gap:9px}.episode-nav a{display:flex;align-items:center;gap:7px;padding:10px;border:1px solid rgba(255,255,255,.12);border-radius:9px;font-size:11px}.player-note{grid-column:1/-1;display:flex;align-items:center;gap:7px;padding-top:16px;border-top:1px solid rgba(255,255,255,.08)}
.iptv-import{display:grid;grid-template-columns:1fr 1.1fr;gap:60px;padding:clamp(25px,5vw,65px);border:1px solid var(--line);border-radius:var(--radius-lg);background:linear-gradient(135deg,var(--surface),var(--bg-soft))}.import-copy h2{margin:10px 0;font:800 38px EVDisplay}.import-copy p{color:var(--text-2);line-height:1.7}.import-forms{display:grid;gap:13px}.import-forms form>label{display:block;margin-bottom:7px;color:var(--text-2);font-size:11px}.import-forms form>div{display:flex;gap:8px}.import-forms input{min-width:0;flex:1;padding:0 13px;border:1px solid var(--line);border-radius:10px;background:var(--bg);color:var(--text)}.file-button{display:flex;align-items:center;gap:8px;width:max-content;padding:6px 0;color:var(--text-2);font-size:11px;cursor:pointer}.tv-layout{display:grid;grid-template-columns:230px 1fr;gap:25px}.tv-sidebar{border-right:1px solid var(--line);padding-right:20px}.playlist-label{display:flex;gap:10px;align-items:center;padding:12px;margin-bottom:16px;background:var(--surface);border-radius:12px}.playlist-label>div{display:grid}.playlist-label small{margin-top:3px;color:var(--text-3);font-size:9px}.live-dot,.channel-live i{width:7px;height:7px;border-radius:50%;background:#ff4f5c;box-shadow:0 0 0 4px rgba(255,79,92,.13)}.tv-sidebar nav{display:grid;gap:3px}.tv-sidebar nav button{display:flex;justify-content:space-between;padding:11px;border:0;border-radius:9px;background:none;color:var(--text-2);cursor:pointer;text-align:left}.tv-sidebar nav button.active{background:var(--surface);color:var(--text)}.tv-sidebar nav small{color:var(--text-3)}.channel-toolbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}.channel-toolbar>span{color:var(--text-3);font-size:11px}.channel-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.channel-card{display:grid;grid-template-columns:48px 1fr auto 24px;align-items:center;gap:12px;padding:12px;border:1px solid var(--line);border-radius:13px;background:var(--surface);transition:.2s}.channel-card:hover{border-color:var(--line-strong);transform:translateY(-2px)}.channel-logo{width:48px;height:48px;display:grid;place-items:center;overflow:hidden;border-radius:11px;background:#fff;color:#111;font-weight:800;font-size:11px}.channel-logo img{width:100%;height:100%;object-fit:contain;padding:5px}.channel-copy{min-width:0;display:grid;gap:4px}.channel-copy strong,.channel-copy small{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.channel-copy strong{font-size:13px}.channel-copy small{color:var(--text-3);font-size:10px}.channel-live{display:flex;align-items:center;gap:7px;color:#ff727b;font-size:8px;font-weight:800;letter-spacing:.1em}.iptv-watch>header>div{display:flex;align-items:center;gap:9px}.iptv-watch>header>div img{width:34px;height:34px;object-fit:contain;background:#fff;border-radius:7px}.iptv-watch>header>div span{display:grid}.iptv-watch>header small{color:#747b84;font-size:9px}.iptv-watch>header>.channel-live{justify-self:end}.video-error{position:absolute;z-index:2;inset:0;display:grid;place-items:center;color:#fff}.health-hero{display:flex;align-items:center;gap:18px;padding:30px;border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--surface);margin-bottom:16px}.health-orb{width:48px;height:48px;border-radius:50%;background:var(--text-3);box-shadow:0 0 0 10px color-mix(in srgb,var(--text-3) 12%,transparent)}.health-orb--online{background:var(--success);box-shadow:0 0 0 10px color-mix(in srgb,var(--success) 12%,transparent)}.health-orb--offline{background:var(--danger)}.health-hero div{display:grid;gap:5px}.health-hero span{font-weight:700}.health-hero small{color:var(--text-3)}.health-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.health-card{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:13px;padding:20px;border:1px solid var(--line);border-radius:var(--radius);background:var(--surface)}.status-dot{width:9px;height:9px;border-radius:50%;background:var(--text-3)}.status-dot--online{background:var(--success)}.status-dot--offline{background:var(--danger)}.status-dot--checking{background:var(--warning)}.health-card h3{margin:0;font-size:14px}.health-card p{margin:5px 0 0;color:var(--text-3);font-size:10px}.health-card>strong{color:var(--text-2);font-size:10px}.control-panel{display:flex;align-items:center;justify-content:space-between;gap:30px;margin-top:35px;padding:30px;border:1px solid var(--line);border-radius:var(--radius);background:var(--surface)}.control-panel h2{margin:8px 0}.control-panel p{max-width:700px;margin:0;color:var(--text-2);font-size:13px;line-height:1.6}.not-found{text-align:center;padding-top:14vh}.not-found>span{color:var(--accent);font:800 clamp(80px,18vw,200px)/.8 EVDisplay;opacity:.18}.not-found h1{font:800 45px EVDisplay;margin:35px 0 10px}.not-found p{color:var(--text-2);margin-bottom:25px}
.dialog-backdrop{position:fixed;z-index:100;inset:0;display:grid;place-items:center;padding:20px;background:rgba(0,0,0,.65);backdrop-filter:blur(8px)}.shortcut-dialog{width:min(480px,100%);padding:24px;border:1px solid var(--line-strong);border-radius:var(--radius-lg);background:var(--surface);box-shadow:var(--shadow)}.shortcut-dialog header{display:flex;justify-content:space-between}.shortcut-dialog h2{margin:8px 0 20px;font:800 28px EVDisplay}.shortcut-list{display:grid;gap:3px}.shortcut-list span{display:flex;align-items:center;justify-content:space-between;padding:12px;border-top:1px solid var(--line);color:var(--text-2);font-size:13px}
@media(max-width:1180px){.catalog-grid{grid-template-columns:repeat(5,1fr)}.channel-grid{grid-template-columns:1fr}.hero__index{display:none}}
@media(max-width:900px){:root{--page:28px}.desktop-nav{display:none}.catalog-grid{grid-template-columns:repeat(4,1fr)}.title-layout{grid-template-columns:190px 1fr}.iptv-import{grid-template-columns:1fr}.health-grid{grid-template-columns:1fr}.tv-layout{grid-template-columns:190px 1fr}.skeleton-rail{grid-template-columns:repeat(4,1fr)}.skeleton-rail>:nth-child(n+5){display:none}}
@media(max-width:700px){:root{--page:18px;--header-h:62px}.app-content{padding-bottom:72px}.site-header{height:var(--header-h)}.site-header .brand small,.profile-trigger b,.profile-trigger>.icon,.theme-button{display:none}.profile-trigger{padding:4px}.search-button{border:0;background:transparent}.mobile-nav{position:fixed;z-index:45;display:grid;grid-template-columns:repeat(5,1fr);inset:auto 0 0;height:calc(66px + env(safe-area-inset-bottom));padding:7px 9px env(safe-area-inset-bottom);border-top:1px solid var(--line);background:color-mix(in srgb,var(--bg) 92%,transparent);backdrop-filter:blur(20px)}.mobile-nav a{display:grid;place-content:center;justify-items:center;gap:3px;color:var(--text-3);font-size:9px}.mobile-nav a.active{color:var(--accent)}.mobile-nav .icon{width:19px}.page{padding-top:35px}.page-stack{gap:38px;padding-top:30px}.profile-screen{padding:25px 18px}.profile-top>span{display:none}.profile-panel h1{font-size:42px}.profile-panel>p{font-size:13px}.profile-grid{gap:14px;margin-top:32px}.profile-card{width:calc(50% - 8px);max-width:145px}.profile-avatar{border-radius:22px}.hero{min-height:68vh;padding-bottom:58px;background-position:62% center}.hero:after{background:linear-gradient(0deg,var(--bg) 0,rgba(5,6,8,.25) 75%),linear-gradient(90deg,rgba(5,6,8,.8),transparent)}.hero h1{font-size:52px}.hero__content>p{font-size:14px;-webkit-line-clamp:2}.media-rail{grid-auto-columns:145px}.continue-rail{grid-auto-columns:270px}.catalog-grid{grid-template-columns:repeat(3,1fr);gap:20px 10px}.page-heading{align-items:flex-start;flex-direction:column}.page-heading h1{font-size:44px}.page-heading p{font-size:13px}.media-card__copy strong{font-size:12px}.media-card__play,.continue-card__play{opacity:1;width:34px;height:34px}.remove-button{opacity:1}.title-hero{min-height:auto;padding-top:80px}.title-layout{grid-template-columns:105px 1fr;gap:18px}.title-copy h1{font-size:40px}.title-description{grid-column:1/-1}.credits{display:none}.title-meta{font-size:10px}.genre-list{display:none}.title-actions .button{padding:0 12px}.episode-card{grid-template-columns:120px 1fr;gap:10px}.episode-card__copy{grid-template-columns:1fr}.episode-number,.episode-card p,.episode-state{display:none}.season-browser>header{align-items:center}.watch-page,.iptv-watch{padding:7px 0 30px}.watch-page .player-header,.iptv-watch>header{padding:0 12px;grid-template-columns:1fr auto}.player-header>div{display:none}.player-back span{display:none}.player-stage,.live-stage{border-radius:0;border-left:0;border-right:0}.player-footer,.iptv-watch>footer{padding:0 18px;grid-template-columns:1fr}.episode-nav{justify-content:space-between}.iptv-import{padding:22px;gap:25px}.import-forms form>div{flex-direction:column}.import-forms input{min-height:44px}.tv-layout{grid-template-columns:1fr}.tv-sidebar{border:0;padding:0;overflow:hidden}.tv-sidebar nav{display:flex;overflow:auto}.tv-sidebar nav button{flex:none;gap:15px;background:var(--surface)}.channel-toolbar{gap:12px}.channel-toolbar>span{display:none}.channel-grid{grid-template-columns:1fr}.health-card{grid-template-columns:auto 1fr}.health-card>strong{grid-column:2}.control-panel{align-items:flex-start;flex-direction:column}.offline-banner{top:5px;width:calc(100% - 20px);border-radius:12px}.dialog-backdrop{align-items:end;padding:10px}.shortcut-dialog{border-radius:22px 22px 12px 12px}}
@media(max-width:430px){.catalog-grid{grid-template-columns:repeat(2,1fr)}.profile-card{max-width:132px}.profile-avatar{font-size:36px}.hero h1{font-size:45px}.hero__meta{gap:7px;font-size:10px}.hero__meta span+span:before{margin-right:7px}.section-title>span{display:none}.title-layout{grid-template-columns:88px 1fr}.title-copy h1{font-size:34px}.title-poster{border-radius:14px}.title-description{font-size:13px}.filter-tabs{width:100%}.filter-tabs button{flex:1}.page-heading h1{font-size:40px}.search-box{height:56px}.search-box input{font-size:15px}}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{scroll-behavior:auto!important;animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}
.sports-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.sports-card{display:grid;gap:16px;padding:20px;border:1px solid var(--line);border-radius:var(--radius-lg);background:var(--surface);color:var(--text);transition:.2s}
.sports-card:hover{border-color:var(--line-strong);transform:translateY(-2px)}
.sports-card__top{display:flex;align-items:center;justify-content:space-between}
.sports-card__teams{display:grid;gap:4px;font-size:24px}
.sports-card__teams span{color:var(--text-3);font-size:12px;text-transform:uppercase}
.sports-card small{color:var(--text-3)}
.sports-card__action{width:max-content}
.sports-watch{min-height:100vh;padding:18px clamp(16px,3vw,45px) 50px;background:#050607}
.sports-watch__header{height:58px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:20px;color:#f5f7f8}
.sports-watch__header>a{display:flex;align-items:center;gap:8px;font-size:12px;color:#b1b5bb}
.sports-watch__header>div{text-align:center;display:grid;gap:4px}
.sports-watch__header>div strong{font-size:13px}
.sports-watch__header>.channel-live{justify-self:end}
.sports-watch__stage{position:relative;width:100%;aspect-ratio:16/9;max-height:calc(100vh - 125px);margin:auto;overflow:hidden;border:1px solid rgba(255,255,255,.1);border-radius:18px;background:#000;box-shadow:0 30px 90px #000}
.sports-watch__stage iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
.sports-watch__footer{display:grid;grid-template-columns:1fr auto;gap:25px;max-width:1200px;margin:35px auto 0}
.sports-watch__footer h1{margin:7px 0;font:800 30px EVDisplay}
.sports-watch__footer p{margin:0;color:#858b94;font-size:12px}

@media(max-width:700px){
  .sports-grid{grid-template-columns:1fr}
  .sports-watch{padding:7px 0 30px}
  .sports-watch__header{padding:0 12px;grid-template-columns:1fr auto}
  .sports-watch__header>div{text-align:left}
  .sports-watch__stage{border-radius:0;border-left:0;border-right:0}
  .sports-watch__footer{padding:0 18px;grid-template-columns:1fr}
}
.sports-stream-picker{
  display:flex;
  flex-wrap:wrap;
  justify-content:center;
  gap:8px;
  margin:10px auto 14px;
}
.sports-stream-picker button{
  padding:9px 13px;
  border:1px solid var(--line);
  border-radius:10px;
  background:var(--surface);
  color:var(--text-2);
  cursor:pointer;
}
.sports-stream-picker button.active{
  background:var(--text);
  color:var(--bg);
  border-color:var(--text);
}
.sports-external{
  position:absolute;
  inset:0;
  display:grid;
  place-items:center;
  gap:12px;
  align-content:center;
  background:#050607;
  color:var(--text-2);
}
.sports-stream-picker{
  display:flex;
  flex-wrap:wrap;
  justify-content:center;
  gap:8px;
  margin:10px auto 14px;
}
.sports-stream-picker button{
  padding:9px 13px;
  border:1px solid var(--line);
  border-radius:10px;
  background:var(--surface);
  color:var(--text-2);
  cursor:pointer;
}
.sports-stream-picker button.active{
  background:var(--text);
  color:var(--bg);
  border-color:var(--text);
}
.sports-external{
  position:absolute;
  inset:0;
  display:grid;
  place-items:center;
  align-content:center;
  gap:12px;
  background:#050607;
  color:var(--text-2);
}

/* ============================================================
   EV0L Streaming
   ============================================================ */

.streaming-page {
  padding-bottom: 4rem;
}

.streaming-controls {
  margin-top: 1.5rem;
}

.streaming-provider-tabs {
  display: flex;
  gap: .5rem;
  flex-wrap: wrap;
  margin-bottom: 1rem;
}

.streaming-provider-tabs button {
  border: 0;
  border-radius: 999px;
  padding: .7rem 1.1rem;
  cursor: pointer;
  font: inherit;
}

.streaming-provider-tabs button.active {
  font-weight: 700;
}

.streaming-search {
  display: flex;
  gap: .75rem;
  max-width: 820px;
}

.streaming-search input {
  flex: 1;
  min-width: 0;
}

.streaming-help {
  margin-top: .55rem;
  opacity: .7;
  font-size: .85rem;
}

.streaming-player-section {
  margin-top: 2rem;
}

.streaming-player-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 1rem;
}

.streaming-player-header h2 {
  margin: .15rem 0 0;
}

.streaming-player {
  width: 100%;
  aspect-ratio: 16 / 9;
  overflow: hidden;
  border-radius: 18px;
  background: #000;
}

.streaming-player iframe {
  width: 100%;
  height: 100%;
  border: 0;
  display: block;
}

.streaming-external-fallback {
  padding: 2rem;
  border-radius: 18px;
  border: 1px solid rgba(255,255,255,.08);
}

.streaming-empty {
  margin-top: 2rem;
  min-height: 260px;
  display: grid;
  place-items: center;
  text-align: center;
  border-radius: 18px;
  border: 1px solid rgba(255,255,255,.08);
  padding: 2rem;
}

@media (max-width: 640px) {
  .streaming-search {
    flex-direction: column;
  }

  .streaming-player-header {
    align-items: flex-start;
  }
}


.system-power-dialog {
  width: min(440px, calc(100vw - 2rem));
}

.system-power-actions {
  display: grid;
  gap: .65rem;
  margin-top: 1rem;
}

.system-power-action {
  width: 100%;
  display: flex;
  align-items: center;
  gap: .9rem;
  padding: 1rem;
  border: 0;
  border-radius: 14px;
  text-align: left;
  cursor: pointer;
  font: inherit;
}

.system-power-action span {
  display: grid;
  gap: .2rem;
}

.system-power-action small {
  opacity: .65;
}

.system-power-action--danger {
  color: #fff;
}


/* ============================================================
   EV0L Welcome Transition
   ============================================================ */

.ev0l-welcome {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: grid;
  place-items: center;
  padding: 1.5rem;
  background:
    radial-gradient(
      circle at 50% 35%,
      rgba(255,255,255,.08),
      transparent 42%
    ),
    rgba(7, 9, 16, .96);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  animation: ev0lWelcomeIn .7s ease both;
  transition:
    opacity .7s ease,
    visibility .7s ease;
}

.ev0l-welcome--leaving {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

.ev0l-welcome__glow {
  position: absolute;
  width: min(60vw, 620px);
  height: min(60vw, 620px);
  border-radius: 50%;
  background: radial-gradient(
    circle,
    rgba(255,255,255,.08),
    transparent 68%
  );
  filter: blur(28px);
  animation: ev0lWelcomePulse 2.4s ease-in-out infinite;
}

.ev0l-welcome__content {
  position: relative;
  z-index: 1;
  width: min(520px, 100%);
  text-align: center;
}

.ev0l-welcome__content h1 {
  margin: .35rem 0 .5rem;
  font-size: clamp(2.2rem, 6vw, 4rem);
  letter-spacing: -.04em;
}

.ev0l-welcome__message {
  margin: 0 auto 1.4rem;
  opacity: .68;
}

.ev0l-welcome__resume {
  display: flex;
  align-items: center;
  gap: 1rem;
  max-width: 430px;
  margin: 0 auto;
  padding: .85rem;
  text-align: left;
  border-radius: 18px;
  background: rgba(255,255,255,.055);
  border: 1px solid rgba(255,255,255,.09);
  box-shadow: 0 20px 70px rgba(0,0,0,.25);
}

.ev0l-welcome__resume img {
  width: 62px;
  height: 88px;
  flex: 0 0 auto;
  object-fit: cover;
  border-radius: 10px;
}

.ev0l-welcome__resume > div {
  min-width: 0;
  display: grid;
  gap: .22rem;
}

.ev0l-welcome__resume strong {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 1rem;
}

.ev0l-welcome__resume small {
  opacity: .62;
}

@keyframes ev0lWelcomeIn {
  from {
    opacity: 0;
  }

  to {
    opacity: 1;
  }
}

@keyframes ev0lWelcomePulse {
  0%, 100% {
    transform: scale(.96);
    opacity: .65;
  }

  50% {
    transform: scale(1.04);
    opacity: 1;
  }
}

@media (max-width: 640px) {
  .ev0l-welcome {
    padding: 1rem;
  }

  .ev0l-welcome__resume {
    gap: .75rem;
  }

  .ev0l-welcome__resume img {
    width: 54px;
    height: 76px;
  }
}

