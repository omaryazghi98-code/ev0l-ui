function AppBackButton({
  fallback = '/',
  label = 'Back',
}: {
  fallback?: string
  label?: string
}) {
  const navigate = useNavigate()

  const goBack = () => {
    if (window.history.length > 1) {
      navigate(-1)
    } else {
      navigate(fallback)
    }
  }

  return (
    <button
      type="button"
      className="button button--subtle"
      onClick={goBack}
    >
      <Icon name="back" />
      {label}
    </button>
  )
}
function LiveChannelLauncher() {
  const [provider, setProvider] = useState<'kick' | 'twitch'>('kick')
  const [username, setUsername] = useState('')
  const [opened, setOpened] = useState('')

  const cleanUsername = username.trim().replace(/^@+/, '')

  function openChannel() {
    if (!cleanUsername) return

    setOpened(cleanUsername)
  }

  const embedUrl =
    provider === 'kick'
      ? `https://player.kick.com/${encodeURIComponent(cleanUsername)}`
      : `https://player.twitch.tv/?channel=${encodeURIComponent(cleanUsername)}&parent=${window.location.hostname}&muted=true`

  return (
    <section className="sports-channel-launcher">
      <div className="section-title">
        <div>
          <span className="eyebrow">Live channels</span>
          <h2>Watch a channel</h2>
        </div>
      </div>

      <div className="sports-channel-controls">
        <div className="sports-provider-tabs">
          <button
            type="button"
            className={provider === 'kick' ? 'active' : ''}
            onClick={() => {
              setProvider('kick')
              setOpened('')
            }}
          >
            Kick
          </button>

          <button
            type="button"
            className={provider === 'twitch' ? 'active' : ''}
            onClick={() => {
              setProvider('twitch')
              setOpened('')
            }}
          >
            Twitch
          </button>
        </div>

        <div className="sports-channel-form">
          <input
            value={username}
            onChange={(event) => {
              setUsername(event.target.value)
              setOpened('')
            }}
            onKeyDown={(event) => {
              if (event.key === 'Enter') {
                openChannel()
              }
            }}
            placeholder={
              provider === 'kick'
                ? 'Kick username'
                : 'Twitch username'
            }
          />

          <button
            type="button"
            className="button button--primary"
            onClick={openChannel}
            disabled={!cleanUsername}
          >
            Watch
          </button>
        </div>
      </div>

      {opened && (
        <div className="sports-channel-player">
          {provider === 'twitch' && window.location.protocol !== 'https:' ? (
            <div className="sports-external">
              <p>
                Twitch embeds require HTTPS.
              </p>

              <a
                className="button button--primary"
                href={`https://www.twitch.tv/${encodeURIComponent(opened)}`}
                target="_blank"
                rel="noreferrer"
              >
                Open Twitch
              </a>
            </div>
          ) : (
            <iframe
              src={embedUrl}
              title={`${provider}  ${opened}`}
              allow="autoplay; fullscreen; picture-in-picture"
              allowFullScreen
            />
          )}
        </div>
      )}
    </section>
  )
}

function getYouTubeVideoId(value: string): string {
  const input = value.trim()

  if (!input) return ''

  if (/^[A-Za-z0-9_-]{6,}$/.test(input)) {
    return input
  }

  try {
    const url = new URL(input)

    if (
      url.hostname === 'youtu.be' ||
      url.hostname === 'www.youtu.be'
    ) {
      return url.pathname.replace(/^\/+/, '').split('/')[0]
    }

    if (
      url.hostname.includes('youtube.com') ||
      url.hostname.includes('youtube-nocookie.com')
    ) {
      const queryId = url.searchParams.get('v')

      if (queryId) {
        return queryId
      }

      const parts = url.pathname
        .split('/')
        .filter(Boolean)

      const liveIndex = parts.indexOf('live')
      const embedIndex = parts.indexOf('embed')
      const shortsIndex = parts.indexOf('shorts')

      if (liveIndex >= 0 && parts[liveIndex + 1]) {
        return parts[liveIndex + 1]
      }

      if (embedIndex >= 0 && parts[embedIndex + 1]) {
        return parts[embedIndex + 1]
      }

      if (shortsIndex >= 0 && parts[shortsIndex + 1]) {
        return parts[shortsIndex + 1]
      }
    }
  } catch {
    return ''
  }

  return ''
}

export function StreamingPage() {
  const [provider, setProvider] =
    useState<'youtube' | 'twitch' | 'kick'>('kick')

  const [query, setQuery] = useState('')
  const [active, setActive] = useState('')

  const username = query.trim().replace(/^@+/, '')

  const watch = () => {
    if (!username) return
    setActive(username)
  }

  const src =
    provider === 'kick'
      ? active
        ? `https://player.kick.com/${encodeURIComponent(active)}`
        : ''
      : provider === 'twitch'
        ? active
          ? `https://player.twitch.tv/?channel=${encodeURIComponent(active)}&parent=${window.location.hostname}&muted=true`
          : ''
        : active
          ? `https://www.youtube.com/embed/${encodeURIComponent(getYouTubeVideoId(active))}`
          : ''

  const youtubeId =
    provider === 'youtube'
      ? getYouTubeVideoId(active)
      : ''

  return (
    <main className="page streaming-page">
      <PageHeading
        eyebrow="Live streaming"
        title="Streaming"
        detail="Watch live creators and broadcasts from YouTube, Kick, and Twitch."
      />

      <section className="streaming-controls">
        <div className="streaming-provider-tabs">
          <button
            type="button"
            className={provider === 'kick' ? 'active' : ''}
            onClick={() => {
              setProvider('kick')
              setQuery('')
              setActive('')
            }}
          >
            Kick
          </button>

          <button
            type="button"
            className={provider === 'twitch' ? 'active' : ''}
            onClick={() => {
              setProvider('twitch')
              setQuery('')
              setActive('')
            }}
          >
            Twitch
          </button>

          <button
            type="button"
            className={provider === 'youtube' ? 'active' : ''}
            onClick={() => {
              setProvider('youtube')
              setQuery('')
              setActive('')
            }}
          >
            YouTube
          </button>
        </div>

        <div className="streaming-search">
          <input
            value={query}
            onChange={(event) => setQuery(event.target.value)}
            onKeyDown={(event) => {
              if (event.key === 'Enter') {
                watch()
              }
            }}
            placeholder={
              provider === 'kick'
                ? 'Enter Kick username'
                : provider === 'twitch'
                  ? 'Enter Twitch username'
                  : 'Paste YouTube live/video URL or ID'
            }
            aria-label="Streaming search"
          />

          <button
            type="button"
            className="button button--primary"
            disabled={!username}
            onClick={watch}
          >
            <Icon name="play" />
            Watch
          </button>
        </div>

        <div className="streaming-help">
          {provider === 'kick' && (
            <span>
              Example: xqc
            </span>
          )}

          {provider === 'twitch' && (
            <span>
              Example: xqc
            </span>
          )}

          {provider === 'youtube' && (
            <span>
              Example: https://youtube.com/live/VIDEO_ID
            </span>
          )}
        </div>
      </section>

      {active && (
        <section className="streaming-player-section">
          <div className="streaming-player-header">
            <div>
              <span className="eyebrow">
                {provider === 'kick'
                  ? 'Kick'
                  : provider === 'twitch'
                    ? 'Twitch'
                    : 'YouTube'}
              </span>

              <h2>{active}</h2>
            </div>

            <button
              type="button"
              className="button button--subtle"
              onClick={() => setActive('')}
            >
              Close
            </button>
          </div>

          {!src && provider === 'youtube' && (
            <EmptyState
              title="Invalid YouTube URL"
              message="Paste a YouTube video or live URL, or enter a video ID."
            />
          )}

          {provider === 'youtube' && !youtubeId && (
            <EmptyState
              title="Invalid YouTube input"
              message="Use a YouTube video/live URL or video ID."
            />
          )}

          {provider === 'twitch' &&
            window.location.protocol !== 'https:' && (
              <div className="streaming-external-fallback">
                <p>
                  Twitch requires an HTTPS embed environment.
                </p>

                <a
                  className="button button--primary"
                  href={`https://www.twitch.tv/${encodeURIComponent(active)}`}
                  target="_blank"
                  rel="noreferrer"
                >
                  Open Twitch
                </a>
              </div>
            )}

          {src &&
            !(
              provider === 'twitch' &&
              window.location.protocol !== 'https:'
            ) &&
            !(
              provider === 'youtube' &&
              !youtubeId
            ) && (
              <div className="streaming-player">
                <iframe
                  src={src}
                  title={`${provider} ${active}`}
                  allow="autoplay; fullscreen; picture-in-picture"
                  allowFullScreen
                />
              </div>
            )}
        </section>
      )}

      {!active && (
        <section className="streaming-empty">
          <div>
            <span className="eyebrow">Choose a platform</span>
            <h2>Start watching</h2>
            <p>
              Enter a channel username or a YouTube video/live URL.
            </p>
          </div>
        </section>
      )}
    </main>
  )
}
export function SportsPage() {
  const [matches, setMatches] = useState<LiveMatch[]>(LIVE_MATCHES)
  const [loading, setLoading] = useState(true)
  const [error, setError] = useState('')

  const loadMatches = () => {
    let cancelled = false

    setLoading(true)
    setError('')

    getSportsMatches()
      .then((dynamicMatches) => {
        if (cancelled) return

        if (dynamicMatches.length > 0) {
          setMatches(dynamicMatches as LiveMatch[])
        } else {
          setMatches(LIVE_MATCHES)
        }
      })
      .catch((e: Error) => {
        if (cancelled) return

        setError(e.message || 'Unable to load live sports.')
        setMatches(LIVE_MATCHES)
      })
      .finally(() => {
        if (!cancelled) {
          setLoading(false)
        }
      })

    return () => {
      cancelled = true
    }
  }

  useEffect(() => loadMatches(), [])

  return (
    <main className="page sports-page">
      <div
        style={{
          display: 'flex',
          marginBottom: '1rem',
          justifyContent: 'flex-start',
        }}
      >
        <AppBackButton fallback="/" />
      </div>
      <PageHeading
        eyebrow="Live sports"
        title="Sports"
        detail="Live matches and events."
      />

      <section className="sports-section">
        <div className="section-title">
          <h2>Football</h2>
          <span>
            {loading
              ? 'Loading'
              : `${matches.length} matches`}
          </span>
        </div>

        {error && (
          <ErrorState
            message={`Live sports feed unavailable. Showing fallback matches. ${error}`}
            retry={loadMatches}
          />
        )}

        <div className="sports-grid">
          {matches.map((match) => (
            <Link
              key={match.id}
              className="sports-card"
              to={`/sports/watch/${match.id}`}
            >
              <div className="sports-card__top">
                <span className="eyebrow">
                  {match.competition}
                </span>

                <span className="channel-live">
                  <i />
                  LIVE
                </span>
              </div>

              <div className="sports-card__teams">
                <strong>{match.home}</strong>
                <span>vs</span>
                <strong>{match.away}</strong>
              </div>

              <small>
                {new Date(match.startTime).toLocaleString()}
              </small>

              <span className="button button--subtle">
                <Icon name="play" />
                Watch match
              </span>
            </Link>
          ))}
        </div>
      </section>
    </main>
  )
}

export function SportsWatchPage() {
  const { matchId = '' } = useParams()
  const navigate = useNavigate()
  const [matches, setMatches] = useState<LiveMatch[]>(LIVE_MATCHES)

  useEffect(() => {
    let cancelled = false

    getSportsMatches()
      .then((dynamicMatches) => {
        if (!cancelled && dynamicMatches.length) {
          setMatches(dynamicMatches as LiveMatch[])
        }
      })
      .catch(() => {
        // Keep hardcoded fallback.
      })

    return () => {
      cancelled = true
    }
  }, [])

  const match =
    matches.find((item) => item.id === matchId) ||
    LIVE_MATCHES.find((item) => item.id === matchId)
  const [selectedStream, setSelectedStream] = useState('')

  useEffect(() => {
    if (match?.streams.length) {
      setSelectedStream(match.streams[0].id)
    }
  }, [match])

  if (!match) {
    return (
      <main className="page">
        <ErrorState
          title="Match not found"
          message="Return to Live Sports and choose a match."
          retry={() => navigate('/sports')}
        />
      </main>
    )
  }

  const stream = match.streams.find((item) => item.id === selectedStream) ?? match.streams[0]

  return (
    <main className="sports-watch">
      <header className="sports-watch__header">
        <Link to="/sports">
          <Icon name="back" />
          All sports
        </Link>

        <div>
          <span className="eyebrow">{match.competition}</span>
          <strong>{match.home} vs {match.away}</strong>
        </div>

        <span className="channel-live"><i />LIVE</span>
      </header>

      {match.streams.length > 0 && (
        <div className="sports-stream-picker">
          {match.streams.map((item) => (
            <button
              key={item.id}
              className={item.id === stream?.id ? 'active' : ''}
              onClick={() => setSelectedStream(item.id)}
            >
              {item.name}
            </button>
          ))}
        </div>
      )}

      <section className="sports-watch__stage">
        {stream ? (
          stream.type === 'iframe' ? (
            <iframe
              src={stream.url}
              title={`${match.home} vs ${match.away}  ${stream.name}`}
              allow="autoplay; fullscreen; picture-in-picture"
              allowFullScreen
            />
          ) : (
            <div className="sports-external">
              <p>{stream.name}</p>
              <a
                className="button button--primary"
                href={stream.url}
              >
                Open stream
              </a>
            </div>
          )
        ) : (
          <div className="sports-external">
            <p>No stream has been added to this match yet.</p>
            <Link className="button button--subtle" to="/sports">
              Back to Sports
            </Link>
          </div>
        )}
      </section>

      <footer className="sports-watch__footer">
        <div>
          <span className="eyebrow">Now watching</span>
          <h1>{match.home} vs {match.away}</h1>
          <p>{match.competition}</p>
        </div>

        <Link className="button button--subtle" to="/sports">
          <Icon name="back" />
          Browse matches
        </Link>
      </footer>
    </main>
  )
}

export function StatusPage() {
  const [state, setState] = useState<'checking' | 'online' | 'offline'>('checking'); const [checked, setChecked] = useState<Date | null>(null)
  const check = () => { setState('checking'); Promise.all([getHistory(), getWatchlist()]).then(() => setState('online')).catch(() => setState('offline')).finally(() => setChecked(new Date())) }
  useEffect(check, [])
  return <main className="page status-page"><PageHeading eyebrow="EV0L system" title="Server status" detail="A truthful view of services the frontend can verify through existing integrations." action={<button className="button button--subtle" onClick={check}><Icon name="refresh"/>Check again</button>}/><div className="health-hero"><span className={`health-orb health-orb--${state}`}/><div><span>{state === 'checking' ? 'Checking EV0L server' : state === 'online' ? 'EV0L server is reachable' : 'EV0L server is unavailable'}</span><small>{checked ? `Last checked ${checked.toLocaleTimeString()}` : 'Connecting to library services…'}</small></div></div><div className="health-grid"><HealthCard name="Library & history" status={state} detail={`${API_BASE}/library`}/><HealthCard name="Cinemeta catalogue" status="external" detail="External metadata provider"/><HealthCard name="IPTV / FFmpeg" status="unknown" detail="Verified only when a channel starts"/><HealthCard name="Simkl" status="unknown" detail="Verified only when an episode syncs"/></div><section className="control-panel"><div><span className="eyebrow">Server control</span><h2>Restart EV0L server</h2><p>The current backend exposes no restart or health endpoint. This control stays disabled rather than pretending an action is available.</p></div><button className="button button--subtle" disabled title="No restart endpoint is available">Restart server</button></section></main>
}
function HealthCard({ name, status, detail }: { name: string; status: string; detail: string }) { const label = status === 'online' ? 'Operational' : status === 'offline' ? 'Unavailable' : status === 'checking' ? 'Checking' : status === 'external' ? 'External service' : 'Not confirmed'; return <article className="health-card"><span className={`status-dot status-dot--${status}`}/><div><h3>{name}</h3><p>{detail}</p></div><strong>{label}</strong></article> }
export function NotFoundPage() { return <main className="page not-found"><span>404</span><h1>This story isn't here.</h1><p>The page may have moved, or the address may be incomplete.</p><Link className="button button--primary" to="/"><Icon name="home"/>Return home</Link></main> }















